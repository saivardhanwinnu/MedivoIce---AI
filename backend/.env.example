# Copy this file to `.env` inside the `backend/` folder and paste your free API keys.
# NEVER commit your real `.env` file to Git!

# Google AI Studio (Free Tier): https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# ElevenLabs (Free Tier): https://elevenlabs.io/
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Optional: Default ElevenLabs voice ID (you can change this later)
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL

# Local SQLite database filename
DATABASE_PATH=medvoice.db
